# Kopiera denna fil till `config.local.toml` och fyll i lokala sökvägar.
# `config.local.toml` är ignorerad i git och får innehålla sökvägar till
# stadens icke-öppna eller skyddsklassade datakällor.

[lokal_data]
baskarta_mapp = ""
tat_laser_mapp = ""
ledningar_mapp = ""

[markmodell]
# Stadens riktiga lagerprofil för baskartans skraffyrer (mall: data/lagerprofiler/lokal_profil.toml.example).
# Relativ sökväg räknas från baskarta_mapp. Tom = repots exempelprofil (inga markslagsytor).
lagerprofil = ""

# Nycklar till Lantmäteriets API (floden data lantmateriet, docs/DATA.md). Hellre i miljön:
#   LANTMATERIET_KLIENT_ID, LANTMATERIET_KLIENT_HEMLIGHET, LANTMATERIET_METOD
[lantmateriet]
klient_id = ""
klient_hemlighet = ""
metod = "oauth2"                       # "oauth2" (API-portalens nyckel) eller "basic" (Geotorgets inloggning)

[sokvagar]
# Exempel på att lägga cache utanför repot:
# cache = "/data/floden/cache"

# Mapp med Nord2000-rapporter och testfallens Excel-filer (checkas aldrig in).
[buller]
kallmapp = ""

# Konton och inloggning (docs/KONTO.md). Standard är "av": allt fungerar som förut, utan inloggning.
# Hemligheter hellre i miljön än här:
#   FLODEN_KONTO_GOOGLE_KLIENT_ID, FLODEN_KONTO_GOOGLE_KLIENT_HEMLIGHET
#   FLODEN_KONTO_ENTRA_KLIENT_ID,  FLODEN_KONTO_ENTRA_KLIENT_HEMLIGHET
[konto]
inloggning = "av"                      # "av" (lokal körning, tester) eller "pa"
databas = "data/konto/konto.sqlite"    # SQLite på lokal disk (ignoreras av git)
offentlig_url = "https://floden.example.se"   # ger redirect-URI: <url>/konto/callback/<leverantör>
cookie_secure = true                   # false bara på localhost (http://localhost:8765)
sessionstimmar = 12
nya_konton = "inbjudan"                # "inbjudan": nytt konto kräver inbjudan, tenant eller intygad domän
oppna_sokvagar = ["/api/halsa"]        # nås utan inloggning

[konto.leverantorer.google]
aktiv = true
klient_id = ""                         # OAuth-klient i Google Cloud Console (webbapplikation)
klient_hemlighet = ""

# Microsoft Entra ID (multitenant). Förberett men av tills en kommun ska in (docs/KONTO.md).
[konto.leverantorer.entra]
aktiv = false
klient_id = ""
klient_hemlighet = ""
# discovery_url = "https://login.microsoftonline.com/organizations/v2.0/.well-known/openid-configuration"

# Generisk OIDC (annan IdP): typ = "oidc". E-postadressen litas inte på om inte epost_betrodd = true.
# [konto.leverantorer.annan]
# typ = "oidc"
# aktiv = false
# discovery_url = "https://sso.example.se/.well-known/openid-configuration"
# scopes = ["openid", "email", "profile", "groups"]
# flertenant = false
# epost_betrodd = false
# [konto.leverantorer.annan.claims]
# grupper = "groups"
# tenant = "tid"

# Rapporternas språk och layout (docs/RAPPORTER.md). Gäller när en rapport skapas och lagras sedan
# i rapporten. Logotyp och typsnitt är lokala filer som aldrig checkas in; rapporten lagrar bara
# deras sha256. Relativa sökvägar räknas från Flodens rot.
[rapport]
# sprakprofil = "sbk"                  # "sbk" (utredningstext från stadsbyggnadskontoret) eller "neutral"
# numrerade_rubriker = false
# numrerade_figurer = false
# avsandare = "Stadsbyggnadskontoret"  # tom sträng = ingen avsändare
# diarienummer = ""
# handlaggare = ""
# accentfarg = "#1F4E79"
# logotyp = "/sökväg/till/logotyp.png"
# typsnitt_brodtext = "/sökväg/till/StockholmType-Regular.ttf"
# typsnitt_rubriker = "/sökväg/till/StockholmType-Bold.ttf"
