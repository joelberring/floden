# Automatisk HTTPS (Let's Encrypt) för FLODEN_DOMAIN. "localhost" ger ett lokalt certifikat.
# Lyft från O-Tid (github.com/joelberring/otid, MIT): deploy/Caddyfile.
{$FLODEN_DOMAIN} {
	# HSTS: webbläsaren använder bara HTTPS mot domänen i ett år (inte includeSubDomains: berring.se har andra tjänster).
	header Strict-Transport-Security "max-age=31536000"
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "DENY"
	# OpenStreetMaps plattservrar kräver Referer: origin skickas till tredje part, aldrig sökväg (samma värde sätter appen på klientfilerna).
	header Referrer-Policy "strict-origin-when-cross-origin"
	# OpenStreetMap-bakgrund (webb/src/karta/osm.ts): plattorna hämtas från tile.openstreetmap.org. MapLibre hämtar dem med fetch och
	# ritar dem som bild, så adressen behövs i både img-src och connect-src. blob: (kartbilder som webben själv hämtat från servern: skuggning, höjdkurvor, ortofoto) och data: (arbetsbänkens tomma bild) hämtas med fetch av MapLibre och blockerades förut av default-src 'self'.
	header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self' blob: data: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'"
	# Floden ska inte indexeras (demo och projekt).
	header X-Robots-Tag "noindex, nofollow"

	# API:t har en egen spärr på 25 MB (Content-Length); här står samma gräns uttryckligen.
	request_body {
		max_size 25MB
	}

	# MCP (Streamable HTTP med SSE-strömmar): ingen komprimering och ingen buffring, så att
	# händelser når klienten direkt. flush_interval -1 skickar varje bit så fort den kommer.
	# Inloggningen (personlig token eller session) sköts av Floden själv, inte av Caddy.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy floden:8765 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy floden:8765 {
			lb_try_duration 10s
		}
	}
}
