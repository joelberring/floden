# Kopiera till .env bredvid docker-compose.prod.yml (aldrig i git).
FLODEN_DOMAIN=floden.berring.se
# Version: main (senaste gröna) eller en commit-sha för att låsa.
FLODEN_TAG=main
# Googles OAuth-klient (docs/KONTO.md avsnitt 2). Hellre här än i config.local.toml.
FLODEN_KONTO_GOOGLE_KLIENT_ID=
FLODEN_KONTO_GOOGLE_KLIENT_HEMLIGHET=
# Hemligheten som krypterar användarnas API-nycklar (sidan Nycklar), docs/DRIFT.md. Saknas den är sidan avstängd.
# Skapa den: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Spara den även i en lösenordshanterare: förloras den går sparade nycklar inte att läsa. Byte: <ny>,<gammal>.
FLODEN_NYCKELHEMLIGHET=
# 1 = bygg demovärlden vid första starten (förval).
FLODEN_DEMO=1
# Serverläge i containern: asgi (uvicorn, förval) eller trad (standardbibliotekets trådserver, reserv).
FLODEN_SERVER=asgi
# Bara för lokal provkörning (FLODEN_DOMAIN=localhost): 1 = starta utan inloggning.
FLODEN_TILLAT_UTAN_INLOGGNING=0
# Hetzner Object Storage (S3-kompatibel): använd webbserverns läs-/projektnyckel här,
# INTE batch-skrivnyckeln (se docs/ARKITEKTUR-DRIFT.md avsnitt 4b).
# FLODEN_S3_TYP=s3
# FLODEN_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# FLODEN_S3_BUCKET=floden-oppen-eu
# FLODEN_S3_REGION=fsn1
# FLODEN_S3_ACCESS_KEY=
# FLODEN_S3_SECRET_KEY=
