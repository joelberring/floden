# Kopiera till .env bredvid docker-compose.prod.yml (aldrig i git).
FLODEN_DOMAIN=floden.berring.se
# Version: main (senaste gröna) eller en commit-sha för att låsa.
FLODEN_TAG=main
# Googles OAuth-klient (docs/KONTO.md avsnitt 2). Hellre här än i config.local.toml.
FLODEN_KONTO_GOOGLE_KLIENT_ID=
FLODEN_KONTO_GOOGLE_KLIENT_HEMLIGHET=
# 1 = bygg demovärlden vid första starten (förval).
FLODEN_DEMO=1
# Bara för lokal provkörning (FLODEN_DOMAIN=localhost): 1 = starta utan inloggning.
FLODEN_TILLAT_UTAN_INLOGGNING=0
