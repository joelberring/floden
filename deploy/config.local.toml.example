# Serverns config.local.toml (kopiera till config.local.toml bredvid docker-compose.prod.yml; aldrig i git).
# Slås ihop med repots config.toml. Hemligheterna läggs i .env (FLODEN_KONTO_GOOGLE_*), inte här.

[konto]
inloggning = "pa"
databas = "data/konto/konto.sqlite"
offentlig_url = "https://floden.berring.se"   # redirect-URI i Google: https://floden.berring.se/konto/callback/google
cookie_secure = true
sessionstimmar = 12
nya_konton = "inbjudan"
oppna_sokvagar = ["/api/halsa"]
# Det påhittade demokvarteret: roll för alla inloggade ("utredare", "lasare" eller "av").
demoprojekt_roll = "utredare"

[konto.leverantorer.google]
aktiv = true

[konto.leverantorer.entra]
aktiv = false

# Objektlagring mot Hetzner Object Storage (nycklar läggs i .env som FLODEN_S3_*, aldrig här).
# [lagring]
# typ = "s3"                                    # "lokal" | "s3"
# endpoint = "https://fsn1.your-objectstorage.com"
# bucket = "floden-oppen-eu"
# region = "fsn1"
#
# [lagring.lokal_cache]
# mapp = "data/cache/s3_lru"
# max_gb = 10.0
# max_alder_dagar = 14
